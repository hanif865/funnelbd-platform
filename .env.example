# ─── Core ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Listen address. Keep 127.0.0.1 behind nginx (not reachable from outside).
HOST=127.0.0.1
# Public origin (used for cookies, absolute URLs). No trailing slash.
BASE_URL=http://localhost:3000

# ─── Database (MongoDB Atlas) ───────────────────────────
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/funnelbd?retryWrites=true&w=majority
MONGODB_URI=

# Storage quota shown on the admin System Status page (MB). 512 = Atlas free
# tier; raise it when self-hosting MongoDB or on a bigger plan.
DB_STORAGE_LIMIT_MB=512

# ─── Backups (scripts/backup.sh) ────────────────────────
# Optional rclone destination for an off-server copy, e.g. gdrive:funnelbd-backups
BACKUP_REMOTE=

# ─── Redis (Upstash) ────────────────────────────────────
# Phase 1: optional. Phase 2 (tracking queue): required.
# Example: rediss://default:password@region.upstash.io:6379
REDIS_URL=

# ─── Auth ───────────────────────────────────────────────
# Generate a long random string. A dev value is provided; change for production.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Session cookie lifetime for visitors (days)
SESSION_COOKIE_DAYS=30

# ─── Seed admin (used by `npm run seed`) ────────────────
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@funnelbd.local
SEED_ADMIN_PASSWORD=admin1234

# ─── Order push notifications (Telegram, free & instant) ─
# Leave both empty to disable. Setup:
#  1. In Telegram, message @BotFather → /newbot → copy the bot token.
#  2. Message your new bot once (say hi), then open
#     https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}.
#     (For a team: add the bot to a group and use the group's chat id.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
