{
  "name": "funnel-bd",
  "version": "1.0.0",
  "description": "Single-product COD sales funnel system for Bangladesh (Node.js)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/app.js",
    "dev:mem": "node server/scripts/dev-mem.js",
    "db:start": "node server/scripts/db-local.js",
    "start": "node server/web.js",
    "worker": "node server/worker.js",
    "worker:dev": "node --watch server/worker.js",
    "seed": "node server/scripts/seed.js",
    "incomplete:dedupe": "node server/scripts/dedupe-incomplete.js",
    "analytics:reset": "node server/scripts/reset-section-analytics.js",
    "funnel:migrate": "node server/scripts/assign-default-funnel.js",
    "images:optimize": "node server/scripts/optimize-images.js",
    "images:variants": "node server/scripts/regenerate-image-variants.js",
    "admin:dev": "npm --prefix admin-panel run dev",
    "admin:build": "npm --prefix admin-panel run build",
    "admin:install": "npm --prefix admin-panel install"
  },
  "overrides": {
    "brace-expansion": "^2.0.2"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "nanoid": "^5.0.9",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0"
  }
}
